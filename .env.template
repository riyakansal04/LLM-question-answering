
# HuggingFace Configuration


# Your HuggingFace API token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# Base model to use for fine-tuning
MODEL_REPO=microsoft/phi-3-mini-4k-instruct

# Private HF repository with LoRA adapters
# Format: your-username/your-private-repo
ADAPTER_REPO=your-org/private-ipl-adapters

# Path to adapters within the repository
ADAPTER_PATH=lora_adapters


# FastAPI Service Configuration


# Server host address
HOST=0.0.0.0

# Server port
PORT=8000

# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1


# Training Configuration


# Base model for training (can be different from MODEL_REPO)
TRAINING_BASE_MODEL=microsoft/phi-3-mini-4k-instruct

# Dataset path
DATASET_PATH=data/ipl_qa.json

# Training output directory
OUTPUT_DIR=outputs/sft

# Number of training epochs
NUM_EPOCHS=3

# Batch size per device
BATCH_SIZE=4

# Whether to push to hub after training
PUSH_TO_HUB=true

# Learning rate
LEARNING_RATE=2e-4


# Kubernetes/Helm Configuration


# Container registry
REGISTRY=youracr.azurecr.io

# Container image tag
IMAGE_TAG=1.0.0

# Kubernetes namespace
KUBERNETES_NAMESPACE=cricket

# Kubernetes context (set via kubectl config)
# KUBERNETES_CONTEXT=production


# Monitoring Configuration


# Prometheus scrape interval
PROMETHEUS_SCRAPE_INTERVAL=30s

# Elasticsearch host for logging
ELASTICSEARCH_HOST=localhost:9200

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/123456


# Debug and Development


# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable debug mode (development only)
DEBUG=false

# Number of worker processes
WORKERS=1

# Optional: Advanced Configuration


# Maximum tokens to generate per inference
MAX_NEW_TOKENS=256

# Inference temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# Top-p for nucleus sampling
TOP_P=0.9

# Device for inference (cpu, cuda, mps)
DEVICE=cpu

# Model cache directory
MODEL_CACHE_DIR=.cache/huggingface

